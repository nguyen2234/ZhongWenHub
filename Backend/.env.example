# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=zhongwenhub_dev
POSTGRES_PORT=5432

# Connection Strings
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=zhongwenhub_dev;Username=postgres;Password=your_secure_postgres_password_here

# JWT Security Configuration
JwtSettings__Secret=REPLACE_WITH_A_VERY_LONG_CRYPTOGRAPHICALLY_SECURE_KEY_AT_LEAST_32_BYTES_IN_PRODUCTION
JwtSettings__Issuer=ZhongWenHub
JwtSettings__Audience=ZhongWenHub-Client
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=7
JwtSettings__RefreshTokenExpirationDaysRememberMe=30

# CORS Origins (comma separated or JSON array)
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000
