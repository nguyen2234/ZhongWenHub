{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZhongWenHubCheckpoint",
  "description": "Schema for execution checkpoints and crash-recovery",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "task_id",
    "task_revision",
    "execution_id",
    "batch_number",
    "total_batches",
    "batch_name",
    "completed_steps",
    "remaining_steps",
    "file_hashes",
    "can_resume",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "checkpoint_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{5,64}$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "execution_id": {
      "type": "string"
    },
    "batch_number": {
      "type": "integer",
      "minimum": 1
    },
    "total_batches": {
      "type": "integer",
      "minimum": 1
    },
    "batch_name": {
      "type": "string"
    },
    "completed_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "in_progress_step": {
      "type": ["string", "null"]
    },
    "remaining_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "file_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "intermediate_data": {
      "type": "object"
    },
    "can_resume": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
