{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZhongWenHubTask",
  "description": "Schema for AI Collaboration Bridge tasks",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "title",
    "description",
    "project",
    "phase",
    "owner",
    "reviewer",
    "status",
    "revision",
    "expected_branch",
    "source_commit",
    "input_files",
    "expected_outputs",
    "acceptance_criteria",
    "safety_constraints",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{5,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "project": {
      "type": "string",
      "enum": ["ZhongWenHub"]
    },
    "phase": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "executor": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CLAIMED",
        "RUNNING",
        "CHECKPOINT_SAVED",
        "COMPLETED",
        "WAITING_FOR_REVIEW",
        "REVIEWING",
        "CHANGES_REQUESTED",
        "ACCEPTED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issue_number": {
      "type": ["integer", "null"]
    },
    "expected_branch": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "input_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "safety_constraints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "checkpoint_path": {
      "type": ["string", "null"]
    },
    "claim_expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
