{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZhongWenHubReview",
  "description": "Schema for ChatGPT Independent QA Reviews",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "task_revision",
    "execution_id",
    "reviewer",
    "reviewed_commit_sha",
    "review_timestamp",
    "decision",
    "summary",
    "findings",
    "required_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "review_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{5,64}$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "execution_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "review_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": ["ACCEPTED", "CHANGES_REQUESTED", "BLOCKED"]
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "component",
          "description",
          "expected_behavior"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "component": { "type": "string" },
          "file_path": { "type": ["string", "null"] },
          "line_range": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "expected_behavior": { "type": "string" },
          "suggested_fix": { "type": ["string", "null"] },
          "regression_test_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "required_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
