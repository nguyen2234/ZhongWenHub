# ZhongWenHub Frontend Environment Configuration

# Backend REST API base URL
VITE_API_BASE_URL=/api/v1

# Toggle Mock Repository vs Real HTTP Repository (true: Mock, false: HTTP API)
VITE_USE_MOCK_API=true

# Comma-separated list of trusted cross-origin API hosts for Authorization & CSRF headers
# Wildcards (*) are strictly prohibited. In production, only HTTPS origins are allowed.
VITE_API_TRUSTED_ORIGINS=https://api.zhongwenhub.vn,http://localhost:5000
